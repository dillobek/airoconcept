# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring. .env HECH QACHON git'ga tushmasin.
# Kalitlarni yaratish: uv run python -m app.cli gen-keys

# Serverda: ENV=production, DOCS_ENABLED=false, COOKIE_SECURE=true
ENV=development
DEBUG=false
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+asyncpg://airo:airo@localhost:5432/airo
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=
ENCRYPTION_KEY=
COOKIE_SECURE=false
# Bo'sh qoldiring: admin panel va /api bitta domenda (admin.DOMAIN) ishlaydi
COOKIE_DOMAIN=

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_DAILY_MESSAGE_LIMIT_PER_USER=60

# Meta (docs/META_SETUP.md ga qarang)
META_GRAPH_VERSION=v26.0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=

# Menejerga bildirishnomalar (bot tokeni bot/ bilan bir xil bo'lishi mumkin)
TELEGRAM_BOT_TOKEN=
MANAGER_CHAT_ID=

{
  "name": "interyer-platforma",
  "private": true,
  "version": "0.1.0",
  "description": "Interyer dizayn va karobka uylarni mebel bilan jihozlash platformasi: backend, sayt, CRM, hisob-kitob boti",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ip/api prisma:migrate",
    "db:seed": "pnpm --filter @ip/api prisma:seed",
    "audit:deps": "pnpm audit --prod"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "prettier": "^3.4.2"
  }
}

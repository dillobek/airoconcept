# .env nomi bilan nusxalang. Git'ga tushmasin.

# @BotFather'dan olingan token
BOT_TOKEN=

# Backend manzili va "agent:chat" scope'li kalit:
#   cd ../backend && uv run python -m app.cli create-api-key --name "Telegram bot" --scopes agent:chat
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=

# polling (lokal) yoki webhook (server)
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/tg/webhook
# Tasodifiy uzun qator: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

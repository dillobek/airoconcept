# ============================================================
# Nusxa oling: cp .env.example .env  — va BARCHA qiymatlarni almashtiring.
# .env hech qachon git'ga qo'shilmaydi.
# Maxfiy kalit yaratish: openssl rand -base64 48
# ============================================================

NODE_ENV=development

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Vergul bilan ajratilgan, aniq domenlar (yulduzcha * ishlatmang)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Productionda: .sizningdomen.uz (sayt, CRM va API bir domen ostida)
COOKIE_DOMAIN=

# --- Ma'lumotlar bazasi ---
POSTGRES_USER=ip_app
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=interyer
DATABASE_URL=postgresql://ip_app:CHANGE_ME_strong_db_password@localhost:5432/interyer?schema=public

# --- Redis (navbatlar, rate limit) ---
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379

# --- Kirish va tokenlar (har biri kamida 32 belgi, har xil) ---
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_access_secret_xxxxxxxx
OTP_PEPPER=CHANGE_ME_min_32_chars_otp_pepper_xxxxxxxxxxxxxxx
# Ichki servislar (bot, plan servisi) API'ga shu kalit bilan murojaat qiladi
INTERNAL_SERVICE_TOKEN=CHANGE_ME_min_32_chars_internal_token_xxxxxx

# --- SMS (Eskiz.uz) ---
SMS_PROVIDER=disabled         # disabled | console | eskiz  (console faqat development uchun)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# --- Fayl saqlash (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=interyer
S3_ACCESS_KEY=CHANGE_ME_minio_access
S3_SECRET_KEY=CHANGE_ME_minio_secret_min_8
S3_PUBLIC_URL=http://localhost:9000/interyer

# --- To'lovlar ---
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Telegram hisob-kitob boti ---
TELEGRAM_BOT_TOKEN=
BOT_API_URL=http://localhost:4000
# Shu summadan (so'm) katta xarajat rahbar tasdig'ini talab qiladi
FINANCE_APPROVAL_THRESHOLD=5000000

# --- Birinchi CRM rahbari (faqat boshlang'ich seed uchun) ---
OWNER_NAME=Sohibjon
OWNER_USERNAME=admin
OWNER_PASSWORD=CHANGE_ME_owner_password_min_12

# --- Chizmani tanish servisi ---
PLAN_SERVICE_URL=http://localhost:8000

# --- Sayt va CRM ---
NEXT_PUBLIC_API_URL=http://localhost:4000
